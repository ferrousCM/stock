# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# 데이터 / 산출물 (재생성 가능하므로 커밋하지 않음)
data/cache/
data/raw/*
output/
*.parquet
*.csv

# 예외: 뉴스 감성 히스토리만은 추적한다.
# 뉴스 소스가 과거 날짜의 감성을 조회할 방법이 없어 앱을 실행한 날부터 하루씩 쌓이는
# 데이터라, 한 번 지우면 과거로 되돌아가 다시 만들 수 없다 (다른 data/ 파일과 성격이 다름).
# 위 *.parquet 보다 뒤에 와야 재포함이 적용된다 (마지막에 일치하는 규칙이 이김).
!data/raw/news_sentiment/
!data/raw/news_sentiment/*.parquet

# 예외: 모의투자 원장도 추적한다. 재생성 가능한 캐시가 아니라 실제 매매 이력·자산 상태라,
# 한 번 지우면 복구 불가능하다 (뉴스 감성 히스토리와 같은 이유). 위 *.csv 보다 뒤에 와야 한다.
# **/*.csv로 재귀 매치해야 한다 — data/portfolio/aggressive/처럼 봇 버전별 하위 디렉터리에
# 있는 CSV도 un-ignore 대상이다(한 단계짜리 *.csv였다면 하위 디렉터리 파일은 계속 무시돼
# GitHub Actions가 매일 커밋을 시도해도 조용히 아무것도 안 올라가는 상태가 된다).
!data/portfolio/
!data/portfolio/**/*.csv

# 에디터 / OS
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
desktop.ini

# Claude Code (settings.json은 공유, settings.local.json은 머신별 권한 목록이라 제외)
.claude/settings.local.json

# 비밀값
.env
